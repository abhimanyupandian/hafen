{
  "name": "hafen-app",
  "productName": "Hafen",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests for chat endpoints: the desktop app and the browser build, on the hafen package (packages/hafen: the engine and the command-line runner for CI)",
  "license": "MIT",
  "type": "module",
  "main": "desktop/main.js",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "app": "vite build && node desktop/start.js",
    "app:build": "vite build && electron-builder --config desktop/builder.json",
    "serve": "node server/serve.js",
    "test": "npm test -w hafen && node --test \"tests/app/*.test.js\"",
    "test:browser": "vite build && playwright test tests/browser",
    "mock": "node packages/hafen/tests/fixtures/mock-endpoint.mjs --port 8791",
    "icons": "node desktop/icons/make.mjs",
    "screenshots": "vite build && node docs/screenshots/make.mjs",
    "demo-video": "vite build && node docs/demo/record.mjs"
  },
  "dependencies": {
    "hafen": "*",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.1"
  }
}
