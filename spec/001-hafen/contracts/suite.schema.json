{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hafen suite",
  "description": "A suite of end-to-end tests for chat endpoints (spec/001-hafen/contracts/test-file.md). Hafen's own checks go further than the schema: a key it doesn't know is a problem (keys of your own start with x-), and is kept in the file.",
  "type": "object",
  "required": [
    "version",
    "tests"
  ],
  "properties": {
    "version": {
      "const": 1,
      "description": "The file format's version."
    },
    "name": {
      "type": "string"
    },
    "group": {
      "type": "integer",
      "minimum": 1,
      "description": "The suite's group: suites in the same group run one after another, groups at the same time; suites with none are one group of their own (contracts/test-file.md, Groups)"
    },
    "provider": {
      "$ref": "#/$defs/providerRef"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/providerRef"
      }
    },
    "environments": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/$defs/scalar"
        }
      }
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "judges": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/judge"
      }
    },
    "defaults": {
      "$ref": "#/$defs/settings"
    },
    "setup": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "teardown": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prices": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/price"
          }
        }
      ]
    },
    "redact": {
      "$ref": "#/$defs/redact"
    },
    "tests": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/test"
      }
    }
  },
  "$defs": {
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "path": {
      "type": "string",
      "pattern": "^\\$",
      "description": "An RFC 9535 JSONPath."
    },
    "providerRef": {
      "description": "A provider file's path, a preset (openai-chat, openai-responses, anthropic-messages, gemini, ollama), plugin:<name>, or an inline provider.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "provider.schema.json"
        }
      ]
    },
    "price": {
      "type": "object",
      "required": [
        "input",
        "output"
      ],
      "properties": {
        "input": {
          "type": "number",
          "minimum": 0,
          "description": "USD per million input tokens."
        },
        "output": {
          "type": "number",
          "minimum": 0,
          "description": "USD per million output tokens."
        },
        "cached_input": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "redact": {
      "type": "object",
      "properties": {
        "patterns": {
          "type": "array",
          "items": {
            "enum": [
              "email",
              "card",
              "phone"
            ]
          }
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "properties": {
        "repeat": {
          "type": "integer",
          "minimum": 1
        },
        "pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "history": {
          "enum": [
            "live",
            "pinned"
          ]
        },
        "on_fail": {
          "enum": [
            "continue",
            "stop"
          ]
        },
        "unsure": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ]
        },
        "unsure_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "retries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "test": {
      "type": "object",
      "required": [
        "name",
        "turns"
      ],
      "allOf": [
        {
          "$ref": "#/$defs/settings"
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^t_[0-9a-z]{8}$"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "group": {
          "type": "integer",
          "minimum": 1,
          "description": "The test's group in its suite: tests in the same group run one after another, groups at the same time; tests with none are one group of their own (contracts/test-file.md, Groups)"
        },
        "provider": {
          "$ref": "#/$defs/providerRef"
        },
        "data": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "limit": {
                  "type": "integer",
                  "minimum": 1
                },
                "shuffle": {
                  "type": "boolean"
                }
              }
            }
          ]
        },
        "row_name": {
          "type": "string",
          "description": "Each data row's name, where the reports and the app say the row (row 3: <name>): a template filled in with the row ({{row.<column>}}), the suite's variables and {{env.NAME}}, never a secret. Without it, the row's first column's value. On one line, cut at 60 characters (contracts/test-file.md, data)"
        },
        "setup": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "teardown": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "turns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/turn"
          }
        },
        "expect_conversation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "turn": {
      "type": "object",
      "required": [
        "user"
      ],
      "properties": {
        "user": {
          "type": "string"
        },
        "reply": {
          "type": "string",
          "description": "The fixed reply used with history: pinned."
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "result"
                ],
                "properties": {
                  "result": {}
                }
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "result"
                  ],
                  "properties": {
                    "when": {
                      "type": "object",
                      "propertyNames": {
                        "pattern": "^\\$"
                      }
                    },
                    "result": {}
                  }
                }
              }
            ]
          }
        },
        "expect": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "request"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "request": {
          "type": "object",
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string"
            },
            "method": {
              "enum": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "HEAD",
                "OPTIONS"
              ]
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {}
          }
        },
        "extract": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/path"
          }
        },
        "expect": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        }
      }
    },
    "judge": {
      "type": "object",
      "required": [
        "kind"
      ],
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "systemone"
            },
            "endpoint": {
              "type": "string",
              "description": "A System One API endpoint; default TypeSafe's hosted Jev."
            },
            "api_key": {
              "type": "string",
              "description": "Usually {{secret.…}}; default {{secret.JEV_API_KEY}}."
            },
            "model": {
              "type": "string"
            }
          }
        },
        {
          "required": [
            "provider"
          ],
          "properties": {
            "kind": {
              "const": "llm"
            },
            "provider": {
              "type": "string"
            },
            "samples": {
              "type": "integer",
              "minimum": 1
            },
            "temperature": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "required": [
            "plugin"
          ],
          "properties": {
            "kind": {
              "const": "plugin"
            },
            "plugin": {
              "type": "string"
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "description": "One check (contracts/checks.md). Either a type, or a path with an operator.",
      "properties": {
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "description": "false turns the check off: it's skipped (reason: turned off) and not counted. Default true."
        },
        "on": {
          "type": "string",
          "pattern": "^(reply|response|thinking|turn|events|tools|conversation)$"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "all": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        },
        "unsure_below": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unsure": {
          "enum": [
            "pass",
            "warn",
            "fail"
          ],
          "description": "A judged check's: how its unsure result counts, over the test's unsure (default fail: counted as failed; warn: passed, with a warning; pass: passed). --unsure is over both. A check with confidence is never unsure, so it doesn't go with that."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1,
          "description": "A judged check's: it passes only when its value does and the judge's confidence is above this (0.5: above 0.5). It's never unsure, so unsure_below doesn't go with it."
        },
        "equals": {},
        "not_equals": {},
        "contains": {},
        "not_contains": {},
        "matches": {
          "type": "string"
        },
        "exists": {
          "type": "boolean"
        },
        "type_is": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean",
            "object",
            "array",
            "null"
          ]
        },
        "min_length": {
          "type": "integer",
          "minimum": 0
        },
        "max_length": {
          "type": "integer",
          "minimum": 0
        },
        "lt": {
          "type": "number"
        },
        "lte": {
          "type": "number"
        },
        "gt": {
          "type": "number"
        },
        "gte": {
          "type": "number"
        },
        "schema": {
          "type": [
            "object",
            "string"
          ]
        },
        "ignore_case": {
          "type": "boolean"
        },
        "max_ms": {
          "type": "integer",
          "minimum": 0
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost": {
          "type": "number",
          "minimum": 0
        },
        "tool": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "propertyNames": {
            "pattern": "^\\$"
          }
        },
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "match": {
          "enum": [
            "exact",
            "in_order",
            "any_order"
          ]
        },
        "value": {
          "description": "The text for contains/not_contains/matches checks, or the event kinds for a sequence check.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "times": {
          "type": "integer",
          "minimum": 1
        },
        "first_token_ms": {
          "type": "integer",
          "minimum": 0
        },
        "question": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 2
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "rubric": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            }
          ]
        },
        "reference": {
          "type": "string"
        },
        "judge": {
          "type": "string"
        },
        "samples": {
          "type": "integer",
          "minimum": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "type"
          ]
        },
        {
          "required": [
            "equals"
          ]
        },
        {
          "required": [
            "not_equals"
          ]
        },
        {
          "required": [
            "contains"
          ]
        },
        {
          "required": [
            "not_contains"
          ]
        },
        {
          "required": [
            "matches"
          ]
        },
        {
          "required": [
            "exists"
          ]
        },
        {
          "required": [
            "type_is"
          ]
        },
        {
          "required": [
            "min_length"
          ]
        },
        {
          "required": [
            "max_length"
          ]
        },
        {
          "required": [
            "lt"
          ]
        },
        {
          "required": [
            "lte"
          ]
        },
        {
          "required": [
            "gt"
          ]
        },
        {
          "required": [
            "gte"
          ]
        },
        {
          "required": [
            "schema"
          ]
        }
      ]
    }
  }
}
